---
export interface Faq { q: string; a: string }
interface Props { items: Faq[] }
const { items } = Astro.props;
---

<div class="bg-flame-200 border border-flame-400/70" data-faq>
  {items.map((item, i) => (
    <div class="border-b border-flame-400/60 last:border-0" data-faq-row data-open={i === 0 ? 'true' : 'false'}>
      <h3>
        <button
          type="button"
          class="w-full flex items-start justify-between gap-5 px-5 sm:px-8 py-5 text-left group"
          aria-expanded={i === 0 ? 'true' : 'false'}
          data-faq-trigger
        >
          <span class="text-d4 text-navy group-hover:text-flame-600 transition-colors">{item.q}</span>
          <span class="acc-chevron shrink-0 mt-1 w-6 h-6 grid place-items-center border border-flame-400 text-flame-600">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </h3>
      <div class="acc-panel">
        <div>
          <p class="px-5 sm:px-8 pb-6 text-copy text-navy/75 max-w-[52rem]" set:html={item.a} />
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    root.querySelectorAll<HTMLElement>('[data-faq-row]').forEach((row) => {
      row.querySelector('[data-faq-trigger]')?.addEventListener('click', () => {
        const next = row.dataset.open !== 'true';
        row.dataset.open = String(next);
        row.querySelector('[data-faq-trigger]')?.setAttribute('aria-expanded', String(next));
      });
    });
  });
</script>
