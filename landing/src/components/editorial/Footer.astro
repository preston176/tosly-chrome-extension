---
import ArrowRight from './ArrowRight.astro';

const STORE = 'https://chromewebstore.google.com/detail/tosly/gnnaglpijpngbbpamicaifonnkjbicig';
const REPO  = 'https://github.com/preston176/tosly-chrome-extension';

/*
  Two columns, not Jasper's four. Anchors are grouped under an "On this page"
  heading so they read as section links rather than as pages that don't exist.
*/
const columns = [
  {
    heading: 'On this page',
    href: '#how-it-works',
    items: [
      { label: 'How it works', href: '#how-it-works' },
      { label: 'Why Tosly',    href: '#why' },
      { label: 'What it flags', href: '#catalogue' },
      { label: 'Use cases',    href: '#audiences' },
      { label: 'Privacy',      href: '#trust' },
      { label: 'FAQ',          href: '#faq' },
    ],
  },
  {
    heading: 'Tosly',
    href: '/privacy',
    items: [
      { label: 'Privacy policy',   href: '/privacy' },
      { label: 'Support',          href: '/support' },
      { label: 'Source code',      href: REPO },
      { label: 'Chrome Web Store', href: STORE },
    ],
  },
];
---

<footer class="bg-graphite-950 text-white/70">
  <div class="shell pt-sec pb-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[repeat(2,minmax(0,1fr))_auto] lg:gap-16">
      {columns.map((col) => (
        <div>
          <a href={col.href} class="inline-flex items-center gap-1.5 text-lede text-white hover:text-flame-500 transition-colors">
            {col.heading}
            <ArrowRight size={14} />
          </a>
          <ul class="mt-4 space-y-1.5">
            {col.items.map((it) => (
              <li>
                <a href={it.href} class="text-fine text-white/60 hover:text-white transition-colors">{it.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- CTA rail -->
      <div class="flex flex-col gap-3 lg:w-[13rem]">
        <a href={STORE} target="_blank" rel="noopener noreferrer" class="btn btn-flame w-full">Add to Chrome</a>
        <a href="/support" class="btn w-full bg-transparent border-flame-600 text-flame-500 hover:bg-flame-600 hover:text-white">
          Talk to us
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="shell py-8 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <span class="font-heading text-[3.5rem] leading-[0.8] text-flame-600 tracking-[-0.03em] block">tosly</span>
        <p class="mt-4 text-fine text-white/45 max-w-md">
          Not legal advice. Tosly surfaces what a document says. For anything that matters, talk to a qualified attorney.
        </p>
      </div>

      <div class="flex flex-col lg:items-end gap-3">
        <div class="flex items-center gap-4">
          <a href={REPO} class="text-white/50 hover:text-white transition-colors" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href={STORE} class="text-white/50 hover:text-white transition-colors" aria-label="Chrome Web Store">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0a12 12 0 0 1 10.39 6H12a6 6 0 0 0-5.66 4L2.6 3.5A12 12 0 0 1 12 0ZM1.61 5.36 7.3 15.2A6 6 0 0 0 12 18l-3.6 5.6A12 12 0 0 1 1.61 5.36ZM23.2 8A12 12 0 0 1 12 24l5.2-9a6 6 0 0 0 .06-7H23.2ZM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z"/></svg>
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-fine text-white/45">
          <span>&copy; {new Date().getFullYear()} Tosly</span>
          <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="/support" class="hover:text-white transition-colors">Support</a>
        </div>
      </div>
    </div>
  </div>
</footer>
