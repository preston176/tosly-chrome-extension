---
interface Props {
  href: string;
  variant?: 'flame' | 'navy' | 'outline';
  external?: boolean;
  class?: string;
}
const { href, variant = 'flame', external = false, class: cls = '' } = Astro.props;

/*
  Spelled out rather than built as `btn-${variant}`: Tailwind only emits
  @layer components rules whose class name appears literally in scanned source,
  so an interpolated name gets purged out of the stylesheet.
*/
const variants = {
  flame:   'btn-flame',
  navy:    'btn-navy',
  outline: 'btn-outline',
} as const;
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class={`btn ${variants[variant]} ${cls}`}
><slot /></a>
