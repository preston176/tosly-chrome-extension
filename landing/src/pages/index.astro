---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import Nav from '../components/editorial/Nav.astro';
import Footer from '../components/editorial/Footer.astro';
import Eyebrow from '../components/editorial/Eyebrow.astro';
import Btn from '../components/editorial/Btn.astro';
import ArrowRight from '../components/editorial/ArrowRight.astro';
import SectionHead from '../components/editorial/SectionHead.astro';
import PixelFrame from '../components/editorial/PixelFrame.astro';
import WhyAccordion from '../components/editorial/WhyAccordion.astro';
import AudienceTabs from '../components/editorial/AudienceTabs.astro';
import FaqList from '../components/editorial/FaqList.astro';
import Shot from '../components/editorial/Shot.astro';
import VideoFacade from '../components/editorial/VideoFacade.astro';
import MockPrivacy from '../components/editorial/mock/MockPrivacy.astro';

const STORE = 'https://chromewebstore.google.com/detail/tosly/gnnaglpijpngbbpamicaifonnkjbicig';
const REPO  = 'https://github.com/preston176/tosly-chrome-extension';

/* Sites whose policies Tosly reads (logo row) */
const companies = [
  {
    name: 'Spotify',
    url: 'https://www.spotify.com/legal/privacy-policy/',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>`
  },
  {
    name: 'Dropbox',
    url: 'https://www.dropbox.com/privacy',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6 1.5L0 5.25l6 3.75 6-3.75L6 1.5zm12 0l-6 3.75 6 3.75 6-3.75L18 1.5zM0 12.75L6 16.5l6-3.75-6-3.75-6 3.75zm18-3.75l-6 3.75 6 3.75 6-3.75-6-3.75zM6 17.625L12 21.375l6-3.75-6-3.75-6 3.75z"/></svg>`
