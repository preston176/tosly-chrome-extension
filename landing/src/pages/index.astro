  {
    name: 'Notion',
    url: 'https://www.notion.so/Privacy-Policy-3468d120cf614d4c9014c09f6adc9091',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.14c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"/></svg>`
  },
  {
    name: 'GitHub',
    url: 'https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`
  },
  {
    name: 'Figma',
    url: 'https://www.figma.com/legal/privacy/',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M15.852 8.981h-4.588V0h4.588c2.476 0 4.49 2.014 4.49 4.49s-2.014 4.491-4.49 4.491zM12.735 7.51h3.117c1.665 0 3.019-1.355 3.019-3.019s-1.354-3.019-3.019-3.019h-3.117V7.51zm0 1.471H8.148c-2.476 0-4.49-2.014-4.49-4.49S5.672 0 8.148 0h4.588v8.981zm-4.587-7.51c-1.665 0-3.019 1.355-3.019 3.019s1.354 3.019 3.019 3.019h3.117V1.471H8.148zm4.587 15.019H8.148c-2.476 0-4.49-2.014-4.49-4.49s2.014-4.49 4.49-4.49h4.588v8.98zM8.148 10.979c-1.665 0-3.019 1.355-3.019 3.019s1.354 3.019 3.019 3.019h3.117v-6.038H8.148zm8.704 9.509c0 2.476-2.014 4.49-4.49 4.49s-4.49-2.014-4.49-4.49 2.014-4.49 4.49-4.49 4.49 2.014 4.49 4.49zm-1.471 0c0-1.665-1.354-3.019-3.019-3.019s-3.019 1.354-3.019 3.019 1.354 3.019 3.019 3.019 3.019-1.354 3.019-3.019z"/></svg>`
  },
  {
    name: 'Linear',
    url: 'https://linear.app/privacy',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M0 14.347l9.653 9.653a12.011 12.011 0 01-9.653-9.653zM0 10.46L13.54 24a12.045 12.045 0 01-2.427.223A12.01 12.01 0 010 12c0-.52.034-1.03.099-1.54zm22.133 9.312L4.228 1.867a12.01 12.01 0 0117.905 17.905zm-19.862-.379L1.007 17.13A12.016 12.016 0 010 12C0 5.373 5.373 0 12 0c1.842 0 3.583.42 5.13 1.007L2.271 19.393z"/></svg>`
  },
  {
    name: 'Vercel',
    url: 'https://vercel.com/legal/privacy-policy',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M24 22.525H0l12-21.05 12 21.05z"/></svg>`
  },
  {
    name: 'Stripe',
    url: 'https://stripe.com/privacy',
    svg: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.591-7.305z"/></svg>`
  },
];

/* ── How it works ──────────────────────────────────────────────────────── */
const steps = [
  {
    title: 'Scan',
    tone: 'lime',
    body: 'Every Terms of Service page gets read the moment it loads.',
    href: '#why',
  },
  {
    title: 'Flag',
    tone: 'flame',
    body: 'Every clause that earns a flag, ranked red, yellow or green.',
    href: '#catalogue',
  },
  {
    title: 'Highlight',
    tone: 'azure',
    body: 'The exact sentence, marked on the actual page.',
    href: '#why',
  },
] as const;

const stepBg: Record<string, string> = {
  lime: 'bg-lime-300', flame: 'bg-flame-300', azure: 'bg-azure-300',
};

/* ── Why people keep it installed ──────────────────────────────────────── */
const whyItems = [
  {
    title: 'Catch the clauses written to be skipped',
    badge: 'NEW',
    body: 'Arbitration waivers, third-party sharing, data selling, deletion rights you do not have. Tosly names the clauses that only matter after something goes wrong, before you agree to them.',
    cta: 'See what it catches',
    href: '#catalogue',
  },
  {
    title: 'Severity you can read at a glance',
    body: 'Three tiers, no score to interpret. Red can cost you money or rights, yellow is worth reading, green is the document doing something in your favour. Two models review every page and the higher severity wins.',
    cta: 'How tiers are assigned',
    href: '#faq',
  },
  {
    title: 'Highlights on the page, not buried in a popup',
    body: 'Summaries are easy to write and easy to be wrong about. Tosly marks the verbatim sentence in the document and puts the plain-English reading right beside it, so you can check its work.',
    cta: 'See a highlight',
    href: '#why',
  },
  {
    title: 'A widget that stays where you put it',
    body: 'Drag it anywhere and it remembers. Turn auto-scan off and it waits to be asked. Results cache for seven days, so revisiting a page costs nothing.',
    cta: 'Widget behaviour',
    href: '#faq',
  },
  {
    title: 'Private by default, permanently',
    body: 'No account and no sign-in. Only the page text and its URL are sent for analysis; settings and cached results live in your browser profile.',
    cta: 'Read the privacy policy',
    href: '/privacy',
  },
];

/* ── Flag specimens (bento) ────────────────────────────────────────────── */
const specimens = [
  {
    tier: 'HIGH RISK',
    tierBg: 'bg-flame-600',
    tierText: 'text-white',
    category: 'Data Selling',
    text: 'We may share your personal data with third-party advertising partners at our discretion.',
  },
  {
    tier: 'HIGH RISK',
    tierBg: 'bg-flame-600',
    tierText: 'text-white',
    category: 'Arbitration',
    text: 'You waive your right to participate in class-action lawsuits or class-wide arbitration.',
  },
  {
    tier: 'CAUTION',
    tierBg: 'bg-sun-700',
    tierText: 'text-navy',
    category: 'Auto-Renewal',
    text: 'Your subscription renews automatically unless cancelled 24 hours before the billing date.',
  },
];

const stats = [
  { figure: '2',      caption: 'models review every page', bg: 'bg-lime-300',  fg: 'text-lime-800' },
  { figure: '7 days', caption: 'cached in your browser',              bg: 'bg-azure-300', fg: 'text-azure-700' },
  { figure: '0',      caption: 'accounts or trackers',                  bg: 'bg-sun-500',   fg: 'text-navy' },
];

/* Categories the analyzer actually returns (backend/llm, extension content script). */
const realCategories = [
  'Third-Party Sharing', 'Data Selling', 'Data Deletion Rights',
  'Auto-Renewal', 'Arbitration',
];

/* ── Audiences ─────────────────────────────────────────────────────────── */
const audiences = [
  {
    tab: 'Shoppers',
    tone: 'flame' as const,
    title: 'Know the return policy before the card details',
    body: 'Checkout pages are where restocking fees, non-refundable windows and forced-renewal terms hide. Tosly reads them while the cart is still open.',
    bullets: ['Refund and restocking clauses', 'Auto-renewal and trial traps', 'Dispute and chargeback limits'],
    specimen: { tier: 'CAUTION', category: 'Auto-Renewal', text: 'Your subscription renews automatically unless cancelled 24 hours before the billing date.' },
  },
  {
    tab: 'Freelancers',
    tone: 'azure' as const,
    title: 'Spot the IP assignment on page nine',
    body: 'Platform terms routinely claim broad licences over work you upload. Tosly surfaces ownership and licence language instead of leaving it to a search box.',
    bullets: ['IP assignment and licence grants', 'Payment hold and clawback terms', 'Unilateral termination rights'],
    specimen: { tier: 'HIGH RISK', category: 'Arbitration', text: 'You waive your right to participate in class-action lawsuits or class-wide arbitration.' },
  },
  {
    tab: 'Parents',
    tone: 'lime' as const,
    title: 'Check what an app collects from a child',
    body: 'Before a game goes on a family tablet, find out what leaves it. Tosly flags data collection, profiling and third-party sharing in plain language.',
    bullets: ['Data collection and profiling', 'Third-party sharing', 'Deletion and access rights'],
    specimen: { tier: 'HIGH RISK', category: 'Third-Party Sharing', text: 'We may share your personal data with third-party advertising partners at our discretion.' },
  },
  {
    tab: 'Developers',
    tone: 'iris' as const,
    title: 'Read the API terms you are about to depend on',
    body: 'Rate limits are documented. The right to revoke access, change pricing, or train on your data usually is not, at least not where you would look.',
    bullets: ['Revocation and deprecation rights', 'Data and model training clauses', 'Liability caps and indemnities'],
    specimen: { tier: 'CAUTION', category: 'Data Selling', text: 'We reserve the right to modify pricing and access limits at any time with notice by email.' },
  },
  {
    tab: 'Job seekers',
    tone: 'sun' as const,
    title: 'Read the non-compete before the offer letter',
    body: 'Employment portals and contractor agreements carry restrictive covenants. Tosly names them so you can negotiate rather than discover them later.',
    bullets: ['Non-compete and non-solicit scope', 'Confidentiality overreach', 'Arbitration and venue clauses'],
    specimen: { tier: 'CLEAR', category: 'Data Deletion Rights', text: 'You may request complete deletion of your account and associated data at any time.' },
  },
];

/* ── Resources ─────────────────────────────────────────────────────────── */
/*
  Each card previews its own destination, captured from the live page rather than
  standing in for it with a colour block. 1000x400 captures match the card's
  2.5:1 box, so nothing is cropped.
*/
const resources = [
  { title: 'Chrome Web Store', body: 'Install Tosly, read reviews, see release notes.', href: STORE,      img: '/img/link-store.jpg',   external: true },
  { title: 'Source code',      body: 'The extension is open. Read it, fork it, audit it.', href: REPO,     img: '/img/link-source.jpg',  external: true },
  { title: 'Get support',      body: 'Something missed? Tell us which clause and where.', href: '/support', img: '/img/link-support.jpg', external: false },
  { title: 'Privacy policy',   body: 'Exactly what is sent, stored, and for how long.',   href: '/privacy', img: '/img/link-privacy.jpg', external: false },
];

/* ── FAQ ───────────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: 'How is this different from pasting the terms into ChatGPT?',
    a: 'Two things. Tosly runs on its own, on the page you are already on, so there is no copy-paste step to skip. And it highlights the verbatim sentence rather than handing back a summary you cannot check. A summary that is subtly wrong is worse than no summary.',
  },
  {
    q: 'Does Tosly send my browsing history anywhere?',
    a: 'No. Document text is sent for analysis when a scan runs, and results are cached in your browser profile for seven days. There is no account, no sign-in, and no background tracking of pages you visit. Auto-scan can be switched off entirely.',
  },
  {
    q: 'What counts as a high-risk clause?',
    a: 'Anything that transfers money, rights, or recourse away from you without a clear trade: arbitration requirements, class-action waivers, unilateral pricing changes, data resale to third parties, and broad IP assignment. Caution covers terms you should read but that are common and negotiable. Clear marks terms in your favour, such as an unconditional deletion right.',
  },
  {
    q: 'Is this legal advice?',
    a: 'No. Tosly tells you what a document says and which parts tend to matter. For anything consequential, a contract, an employment agreement, a dispute, talk to a qualified attorney.',
  },
  {
    q: 'Which sites does it work on?',
    a: 'Any page with terms on it. Tosly detects Terms of Service, Privacy Policy, EULA and similar documents by structure rather than a maintained allowlist, so it works on sites nobody has audited.',
  },
  {
    q: 'What does it cost?',
    a: 'Nothing. Tosly is free on the Chrome Web Store, and the extension source is public.',
  },
];
---

<EditorialLayout
  title="Tosly: Read the Terms of Service before you accept them"
  description="Tosly is a free Chrome extension that scans Terms of Service pages, flags predatory clauses by severity, and highlights the exact sentence on the page before you click Accept."
  keywords="terms of service scanner, privacy policy analyzer, chrome extension, legal risk, ToS highlights"
  canonical="https://tosly.online/"
  ogUrl="https://tosly.online/"
  ogImage="https://tosly.online/img/demo-poster.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Tosly',
    applicationCategory: 'BrowserApplication',
    operatingSystem: 'Chrome',
    description: 'AI Chrome extension that scans Terms of Service and highlights predatory clauses.',
    url: 'https://tosly.online/',
    installUrl: STORE,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })} />
  <Nav />

  <main>
    <!-- ══ Hero ═══════════════════════════════════════════════════════════ -->
    <section class="bg-paper-100 pt-14 pb-0 overflow-hidden">
      <div class="shell">
        <!-- Announcement -->
        <div class="flex justify-center">
          <a href="#catalogue" class="group inline-flex items-center gap-3 bg-white pl-1.5 pr-3.5 py-1.5 border border-navy/10">
            <span class="marker bg-lime-400 text-lime-800">New!</span>
            <span class="text-fine font-medium text-navy">Tosly now flags class-action waivers</span>
            <span class="text-flame-600"><ArrowRight size={14} /></span>
          </a>
        </div>

        <!-- Headline -->
        <h1 class="mt-9 text-d1 text-navy text-center max-w-[46rem] mx-auto">
          You clicked Accept.<br class="hidden sm:block" /> Without reading it.
        </h1>

        <p class="mt-6 text-lede text-navy/75 text-center max-w-[38rem] mx-auto">
          Tosly scans the Terms of Service before you agree, flags the clauses built to
          work against you, and highlights the exact sentence on the page.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Btn href={STORE} variant="flame" external>
            <img src="/google.svg" alt="" width="16" height="16" class="w-4 h-4" />
            Add to Chrome, free
          </Btn>
          <Btn href="#catalogue" variant="outline">See what it catches</Btn>
        </div>
      </div>

      <!-- Demo: the product doing the thing, on a flat colour band -->
      <div class="mt-14 relative pb-sec-sm">
        <div class="absolute inset-x-0 top-[24%] bottom-[8%] bg-rose-400"></div>

        <div class="relative shell">
          <div class="max-w-[56rem] mx-auto relative">
            <VideoFacade
              id="ivAgRwcxAH4"
              title="Tosly scanning a Terms of Service page"
              poster="/img/demo-poster.jpg"
            />

            <!-- "3 found" is what the widget reports in this exact scan -->
            <div class="hidden sm:block absolute -right-3 lg:-right-8 -bottom-7 bg-flame-600 text-white px-4 py-2.5 lg:px-5 lg:py-3.5">
              <span class="font-heading text-[1.5rem] lg:text-[2rem] leading-none block">3 flags</span>
              <span class="font-mono text-[0.62rem] lg:text-label opacity-80">FOUND ON THIS PAGE</span>
            </div>

            <div class="hidden lg:block absolute -left-10 -bottom-10 w-16 h-16 bg-azure-800"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ Marquee ════════════════════════════════════════════════════════ -->
    <section class="py-12 border-b border-navy/10">
      <h2 class="text-center text-d4 text-navy/50 font-heading mb-8">
        Reads the fine print on the sites you already use
      </h2>
      <div class="marquee">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <div class="flex items-center shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
              {companies.map((c) => (
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-7 lg:px-10 flex flex-col items-center gap-2 text-navy/45 hover:text-navy transition-colors"
                  aria-label={`${c.name} privacy policy`}
                >
                  <span class="block w-8 h-8" set:html={c.svg} />
                  <span class="font-mono text-[0.7rem] tracking-wide whitespace-nowrap">{c.name}</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ How it works ═══════════════════════════════════════════════════ -->
    <section id="how-it-works" class="pt-sec pb-sec-sm">
      <div class="shell">
        <SectionHead
          eyebrow="How Tosly works"
          tone="flame"
          class="reveal"
          lede="Three steps run before you reach the Accept button, and none of them are yours. Tosly detects the document, has two models read it end to end, then marks the sentences that earned a flag."
        >
          The reading happens before you agree
          <div slot="cta" class="mt-8">
            <Btn href="#why" variant="navy">See a live scan</Btn>
          </div>
        </SectionHead>

        <!-- Three cards -->
        <div class="mt-14 grid gap-4 md:grid-cols-3">
          {steps.map((s, i) => (
            <a href={s.href} class={`reveal group flex flex-col ${stepBg[s.tone]}`} style={`transition-delay:${i * 80}ms`}>
              <div class="px-6 pt-7 pb-3 flex items-baseline justify-between gap-3">
                <h3 class="text-d3 text-navy">{s.title}</h3>
                <span class="font-mono text-label text-navy/45">0{i + 1}</span>
              </div>

              <div class="px-6 pb-7 pt-2 flex items-end justify-between gap-4 flex-1">
                <p class="text-copy text-navy/80 max-w-[16rem]">{s.body}</p>
                <span class="text-navy shrink-0 transition-transform group-hover:translate-x-1">
                  <ArrowRight size={18} />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ Why ════════════════════════════════════════════════════════════ -->
    <section id="why" class="py-sec">
      <div class="shell">
        <div class="max-w-[38rem] reveal">
          <Eyebrow tone="lime" class="mb-5">Why it stays installed</Eyebrow>
          <h2 class="text-d2 text-navy">Built for the part nobody reads</h2>
          <p class="mt-5 text-copy text-navy/75">
            Five things Tosly does that a search box and good intentions do not.
          </p>
        </div>

        <div class="mt-12 reveal">
          <WhyAccordion items={whyItems}>
            <Shot
              slot="mock-0" tone="flame" class="max-w-[25rem]"
              src="/img/shot-panel.png" width={700} height={900}
              alt="Tosly's panel on Spotify's privacy policy listing three flags: Third-Party Sharing and Data Deletion Rights as high risk, Data Selling as caution."
              caption="REAL SCAN / SPOTIFY PRIVACY POLICY"
            />
            <Shot
              slot="mock-1" tone="lime" class="max-w-[30rem]"
              src="/img/shot-severity.png" width={660} height={470}
              alt="Three flagged clauses with their severity chips: two marked HIGH RISK in red, one marked CAUTION in yellow."
              caption="SEVERITY CHIPS, UNRETOUCHED"
            />
            <Shot
              slot="mock-2" tone="sun"
              src="/img/shot-highlight.png" width={1199} height={207}
              alt="A sentence in Spotify's policy highlighted in place: 'After your account is deleted, we keep some data for a longer time period but for very limited purposes.'"
              caption="IN-PAGE HIGHLIGHT, VERBATIM"
            />
            <Shot
              slot="mock-3" tone="azure" class="max-w-[20rem]"
              src="/img/shot-badge.png" width={280} height={290}
              alt="Tosly's shield badge sitting in the corner of the page, showing a HIGH RISK label."
              caption="THE WIDGET, WHERE YOU LEFT IT"
            />
            <MockPrivacy slot="mock-4" />
          </WhyAccordion>
        </div>
      </div>
    </section>

    <!-- ══ Specimens / bento ══════════════════════════════════════════════ -->
    <section id="catalogue" class="py-sec bg-paper-50">
      <div class="shell">
        <SectionHead eyebrow="What a flag looks like" tone="sun" class="reveal">
          Real clauses, quoted verbatim
          <div slot="cta" class="mt-8">
            <Btn href={STORE} variant="navy" external>Scan a page yourself</Btn>
          </div>
        </SectionHead>

        <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <!-- Stats -->
          {stats.map((s, i) => (
            <div class={`reveal ${s.bg} p-6 flex flex-col justify-between min-h-[12rem]`} style={`transition-delay:${i * 70}ms`}>
              <span class={`font-heading text-[clamp(2.25rem,3.4vw,2.75rem)] leading-none ${s.fg}`}>{s.figure}</span>
              <span class="text-fine text-navy/70 mt-4 pt-4 border-t border-navy/12">{s.caption}</span>
            </div>
          ))}

          <!-- Categories the analyzer returns, rather than a made-up count -->
          <div class="reveal bg-white border border-navy/12 p-6 flex flex-col justify-between min-h-[12rem]">
            <ul class="flex flex-wrap gap-1.5 content-start">
              {realCategories.map((cat) => (
                <li class="font-mono text-[0.7rem] bg-paper-100 text-navy/75 px-1.5 py-1">{cat}</li>
              ))}
            </ul>
            <span class="text-fine text-navy/70 mt-4 pt-4 border-t border-navy/12">categories seen in real scans</span>
          </div>

          <!-- Clause specimens -->
          {specimens.map((sp, i) => (
            <div class="reveal bg-white border border-navy/12 p-6 flex flex-col justify-between min-h-[13rem] md:col-span-1 lg:col-span-2" style={`transition-delay:${i * 70}ms`}>
              <div>
                <div class="flex items-center gap-2.5 mb-4">
                  <span class={`marker ${sp.tierBg} ${sp.tierText} !text-[0.65rem]`}>{sp.tier}</span>
                  <span class="font-mono text-label text-navy/50">{sp.category}</span>
                </div>
                <p class="font-heading text-d4 text-navy">&ldquo;{sp.text}&rdquo;</p>
              </div>
              <p class="mt-5 text-fine text-navy/55">Quoted from the document, highlighted in place.</p>
            </div>
          ))}

          <!-- Filler block -->
          <div class="reveal bg-iris-400 min-h-[13rem] lg:col-span-2 relative">
            <div class="absolute inset-0 grid place-items-center p-6 text-center">
              <p class="font-heading text-d3 text-iris-700 max-w-[18rem]">
                Green flags count too.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ Audiences ══════════════════════════════════════════════════════ -->
    <section id="audiences" class="py-sec">
      <div class="shell">
        <div class="text-center flex flex-col items-center reveal">
          <Eyebrow tone="lime" class="mb-5">Use cases</Eyebrow>
          <h2 class="text-d2 text-navy max-w-[46rem]">
            Consent runs on reading.<br class="hidden sm:block" /> Tosly does the reading.
          </h2>
          <p class="mt-5 text-copy text-navy/75 max-w-[38rem]">
            The clauses that matter change with what you are signing up for. Pick the one that sounds like you.
          </p>
        </div>

        <div class="mt-12 reveal">
          <AudienceTabs items={audiences} />
        </div>
      </div>
    </section>

    <!-- ══ Trust ══════════════════════════════════════════════════════════ -->
    <section id="trust" class="pt-sec-sm pb-sec">
      <div class="shell">
        <PixelFrame class="reveal max-w-[68rem] mx-auto">
          <Eyebrow tone="flame" class="mb-4">Privacy</Eyebrow>
          <h2 class="text-d2 text-navy">Private by design, not by promise</h2>
          <p class="mt-4 text-copy text-navy/75 max-w-[30rem]">
            No account, no sign-in, and no record of what you read leaving your machine.
            Settings and cached results stay in your browser profile.
          </p>
          <div class="mt-7">
            <Btn href="/privacy" variant="outline">Read the privacy policy</Btn>
          </div>
        </PixelFrame>
      </div>
    </section>

    <!-- ══ Resources ══════════════════════════════════════════════════════ -->
    <section id="resources" class="py-sec bg-paper-50">
      <div class="shell">
        <SectionHead eyebrow="Resources" tone="azure" class="reveal">
          Everything else you might want
        </SectionHead>

        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {resources.map((r, i) => (
            <a
              href={r.href}
              target={r.external ? '_blank' : undefined}
              rel={r.external ? 'noopener noreferrer' : undefined}
              class="reveal group bg-white border border-navy/12 flex flex-col hover:border-navy/35 transition-colors"
              style={`transition-delay:${i * 60}ms`}
            >
              <img
                src={r.img}
                alt=""
                width="1000"
                height="400"
                loading="lazy"
                decoding="async"
                class="w-full aspect-[2.5/1] object-cover object-top border-b border-navy/12"
              />
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="text-d4 text-navy">{r.title}</h3>
                <p class="mt-2.5 text-copy text-navy/70 flex-1">{r.body}</p>
                <span class="arrow-link mt-5 text-flame-600">
                  {r.external ? 'Open' : 'Read'}
                  <ArrowRight size={14} />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ Closing CTA ════════════════════════════════════════════════════ -->
    <section class="py-sec">
      <div class="shell grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <h2 class="text-d2 text-navy max-w-[26rem]">Stop agreeing to things you haven&rsquo;t read</h2>
          <p class="mt-5 text-copy text-navy/75 max-w-[30rem]">
            It takes one click to install and zero clicks to use. The next Terms of Service
            page you open will already be read by the time you get to the bottom.
          </p>
          <div class="mt-8">
            <Btn href={STORE} variant="flame" external>
              <img src="/google.svg" alt="" width="16" height="16" class="w-4 h-4" />
              Add to Chrome, free
            </Btn>
          </div>
        </div>

        <!-- Collage -->
        <div class="reveal relative">
          <div class="bg-azure-300 aspect-[4/3]"></div>
          <div class="absolute inset-0 p-6 sm:p-10 flex flex-col justify-between">
            <div class="bg-white border border-navy/12 p-4 sm:p-5 max-w-[19rem] shadow-[0_18px_50px_-16px_rgba(0,6,61,0.25)]">
              <span class="marker bg-flame-600 text-white !text-[0.65rem]">HIGH RISK</span>
              <p class="mt-3 font-heading text-d4 text-navy">
                &ldquo;We reserve the right to modify pricing at any time.&rdquo;
              </p>
            </div>

            <div class="self-end bg-navy text-white px-5 py-4 max-w-[15rem]">
              <span class="font-heading text-[2.25rem] leading-none block">7 days</span>
              <span class="font-mono text-label opacity-70">CACHED, THEN FORGOTTEN</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ FAQ ════════════════════════════════════════════════════════════ -->
    <section id="faq" class="pb-sec">
      <div class="shell relative">
        <!-- Rotated sticker -->
        <span
          class="absolute -top-4 left-4 sm:left-8 z-10 bg-flame-600 text-navy font-heading text-[1.75rem] sm:text-[2.25rem] leading-none px-4 py-1.5 -rotate-6 shadow-[0_10px_28px_-10px_rgba(0,6,61,0.35)]"
        >FAQs</span>

        <div class="pt-10 reveal">
          <FaqList items={faqs} />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</EditorialLayout>
