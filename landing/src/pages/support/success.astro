---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import Nav from '../../components/editorial/Nav.astro';
import Footer from '../../components/editorial/Footer.astro';
import Eyebrow from '../../components/editorial/Eyebrow.astro';
import Btn from '../../components/editorial/Btn.astro';
---

<EditorialLayout
  title="Message sent - Tosly"
  description="Thanks for reaching out. We'll get back to you shortly."
  noIndex={true}
>
  <Nav />

  <main class="min-h-[62vh] grid place-items-center py-sec">
    <div class="shell">
      <div class="max-w-[34rem]">
        <div class="w-12 h-12 grid place-items-center bg-lime-600 text-navy mb-7">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>

        <Eyebrow tone="lime" class="mb-5">Sent</Eyebrow>
        <h1 class="text-d1 text-navy">Message received</h1>

        <p class="mt-6 text-lede text-navy/75">
          Thanks for reaching out. We read every message and reply within 24 hours.
          Check the inbox of the address you submitted, the reply will come from there.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <Btn href="/" variant="navy">Back to home</Btn>
          <Btn href="/support" variant="outline">Send another message</Btn>
        </div>

        <p class="mt-12 text-fine text-navy/55">
          Reporting something urgent? You can also
          <a
            href="https://github.com/preston176/tosly-chrome-extension/issues/new"
            class="underline underline-offset-2 hover:text-flame-600 transition-colors"
          >open a GitHub issue</a>.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</EditorialLayout>
